FROM php:8.3-cli-bookworm AS php-base

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        libicu-dev \
        libonig-dev \
        libsqlite3-dev \
        libzip-dev \
    && docker-php-ext-install -j"$(nproc)" \
        bcmath \
        intl \
        mbstring \
        pdo_sqlite \
        zip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /var/www/html

FROM php-base AS php-build

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --no-scripts \
    --no-autoloader \
    --prefer-dist

COPY . .

RUN composer dump-autoload --no-dev --no-interaction --optimize \
    && php artisan wayfinder:generate --with-form

FROM node:22-bookworm-slim AS assets

WORKDIR /var/www/html

COPY package.json package-lock.json ./
RUN npm ci --no-audit --no-fund

COPY . .
COPY --from=php-build /var/www/html/resources/js/actions ./resources/js/actions
COPY --from=php-build /var/www/html/resources/js/routes ./resources/js/routes
COPY --from=php-build /var/www/html/resources/js/wayfinder ./resources/js/wayfinder

ENV SKIP_WAYFINDER_GENERATION=1

RUN npm run build

FROM php-base AS runtime

WORKDIR /var/www/html

COPY --from=php-build /var/www/html /var/www/html
COPY --from=assets /var/www/html/public/build /var/www/html/public/build

ENV APP_ENV=production \
    APP_DEBUG=false \
    CACHE_STORE=array \
    LARAVEL_STORAGE_PATH=/tmp/laravel-storage \
    LOG_CHANNEL=stderr \
    QUEUE_CONNECTION=sync \
    SESSION_DRIVER=cookie

EXPOSE 80

CMD ["sh", "-c", "mkdir -p \"$LARAVEL_STORAGE_PATH/framework/cache/data\" \"$LARAVEL_STORAGE_PATH/framework/sessions\" \"$LARAVEL_STORAGE_PATH/framework/views\" \"$LARAVEL_STORAGE_PATH/logs\" && exec php artisan serve --host=0.0.0.0 --port=\"${PORT:-80}\""]
